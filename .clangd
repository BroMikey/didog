# .clangd
Diagnostics:
  Suppress:
    - non_asm_stmt_in_naked_function
    - asm_naked_parm_ref
    # stm32f10x.h 与 stm32f10x_conf.h 互相包含，单独打开头文件时的正常提示
    - pp_including_mainfile_in_preamble

CompileFlags:
  Add:
    - --target=arm-none-eabi
    - -mcpu=cortex-m3
    - -mthumb
    - -std=c99
    - -DSTM32F10X_MD
    - -DUSE_STDPERIPH_DRIVER
    - -DHSE_VALUE=8000000

    # 头文件搜索路径
    - -IStart
    - -ILibrary
    - -IUser
    - -ISystem
    - -isystem
    - null/share/armcc/include
    - -ferror-limit=0
  Remove:
    - --cpu
    - --li
    - --c99
    - --split_sections
    - --diag_suppress=*
    - --no_depend_system_headers
    - --depend
    - --strict
    - --enum_is_int
    - --gnu
    - --apcs=*
    - --signed_chars
    - --split_ldm
    - --execute_only
    - -Otime
  # CompilationDatabase: "./build/Target 1"
